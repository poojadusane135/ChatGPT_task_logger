{
  "manifest_version": 3,
  "name": "ChatGPT Logger V2",
  "version": "2.0",

  "permissions": [
    "storage"
  ],

  "host_permissions": [
    "http://localhost:5000/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": [
        "chatgpt_url/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}